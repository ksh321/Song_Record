{
  "schema": 1,
  "always": [],
  "workflows": [
    {
      "path": ".github/workflows/ci.yml",
      "name": "CI",
      "exclude": [
        "docs/**",
        "*.md",
        "tools/**",
        ".gitmessage.txt",
        ".github/**"
      ],
      "include": [
        "docs/contracts/**"
      ],
      "jobs": [
        {
          "name": "Flutter analyze, test, and Android build",
          "key": "flutter",
          "exclude": [
            "services/**",
            "infra/**",
            "docs/**",
            "*.md",
            "tools/**",
            ".gitmessage.txt",
            ".github/**"
          ],
          "include": [
            "docs/contracts/**"
          ]
        },
        {
          "name": "Spring Boot build and test",
          "key": "api",
          "exclude": [
            "apps/**",
            "docs/**",
            "*.md",
            "tools/**",
            ".gitmessage.txt",
            ".github/**"
          ],
          "include": [
            "docs/contracts/**"
          ]
        },
        {
          "name": "MySQL migrations and constraints",
          "key": "mysql",
          "exclude": [
            "apps/**",
            "docs/**",
            "*.md",
            "tools/**",
            ".gitmessage.txt",
            ".github/**"
          ],
          "include": [
            "docs/contracts/**"
          ]
        }
      ]
    },
    {
      "path": ".github/workflows/api-contract.yml",
      "name": "API contract",
      "exclude": [
        "apps/**",
        "services/**",
        "infra/**",
        "docs/**",
        "*.md",
        "tools/**",
        ".gitmessage.txt",
        ".github/**"
      ],
      "include": [
        "docs/contracts/**",
        "infra/scripts/verify_api_contract.py",
        "infra/scripts/requirements-api-contract.txt"
      ],
      "jobs": [
        {
          "name": "contract"
        }
      ]
    },
    {
      "path": ".github/workflows/idempotency-mysql.yml",
      "name": "Idempotency MySQL",
      "exclude": [
        "apps/**",
        "docs/**",
        "*.md",
        "tools/**",
        ".gitmessage.txt",
        ".github/**"
      ],
      "include": [
        "docs/contracts/**"
      ],
      "jobs": [
        {
          "name": "mysql"
        }
      ]
    },
    {
      "path": ".github/workflows/development-workflow.yml",
      "name": "Development workflow",
      "exclude": [
        "apps/**",
        "services/**",
        "infra/**",
        "fixtures/**",
        "docs/**",
        "*.md",
        ".gitmessage.txt",
        ".github/**",
        "tools/**"
      ],
      "include": [],
      "jobs": [
        {
          "name": "Source index and automation checks"
        }
      ]
    }
  ]
}
