[Unit]
Description=Song Record experiment connected monitor freshness checks
After=song-record-observation.service song-record-cost.service
ConditionPathExists=/etc/song-record-experiment/monitoring.json
ConditionPathExists=!/etc/song-record-experiment/user-requested-pause

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/song-record-experiment/operations/health.py
TimeoutStartSec=60
