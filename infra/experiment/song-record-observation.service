[Unit]
Description=Song Record private experiment aggregate observation
After=docker.service song-record-experiment.service
Requires=docker.service
ConditionPathExists=/opt/song-record-experiment/operations/artifact.json
ConditionPathExists=!/etc/song-record-experiment/user-requested-pause

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/song-record-experiment/operations/observe.py
TimeoutStartSec=90
