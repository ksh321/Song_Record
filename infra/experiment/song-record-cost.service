[Unit]
Description=Song Record experiment R2 cost observation and owned gate
After=docker.service song-record-experiment.service
Requires=docker.service
ConditionPathExists=/etc/song-record-experiment/monitoring.json
ConditionPathExists=!/etc/song-record-experiment/user-requested-pause

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/song-record-experiment/operations/cost.py
TimeoutStartSec=240
